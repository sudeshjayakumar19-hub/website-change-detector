# Application Settings
APP_NAME="Website Change Detector"
APP_ENV="development"
DEBUG=false
HOST="127.0.0.1"
PORT=8000

# Database Configuration
DATABASE_URL="sqlite:///./change_detector.db"

# Monitoring Engine Settings
USER_AGENT="WebsiteChangeDetector/1.0 (+https://github.com/vinnovateit/website-change-detector; responsible-monitor)"
REQUEST_TIMEOUT_SECONDS=15
MAX_REDIRECTS=5
MAX_RESPONSE_BYTES=5242880
MAX_RETRIES=2
RETRY_BACKOFF_FACTOR=1.5
HOST_MIN_INTERVAL_SECONDS=5.0
RESPECT_ROBOTS_TXT=true
ENABLE_PLAYWRIGHT_FALLBACK=false
PLAYWRIGHT_TIMEOUT_MS=15000

# Scheduler Settings
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30

# Optional Email Alert Configuration (SMTP)
SMTP_ENABLED=false
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="alerts@example.com"
SMTP_TO_EMAIL="recipient@example.com"
SMTP_USE_TLS=true

# Optional Generic Webhook Configuration (Discord / Telegram / Slack / Custom JSON)
WEBHOOK_ENABLED=false
WEBHOOK_URL=""
WEBHOOK_SECRET=""
TELEGRAM_CHAT_ID=""
